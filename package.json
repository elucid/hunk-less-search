{
  "name": "hunk-less-search",
  "version": "0.1.0",
  "description": "less-style `/` forward search for the Hunk review stream, with in-diff match marks",
  "keywords": [
    "hunk-extension",
    "hunkdiff",
    "terminal",
    "tui",
    "search",
    "less"
  ],
  "homepage": "https://github.com/elucid/hunk-less-search#readme",
  "bugs": {
    "url": "https://github.com/elucid/hunk-less-search/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elucid/hunk-less-search.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "search": "hunk diff --extension .",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.14",
    "hunkdiff": "^0.19.0",
    "react": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "hunk": {
    "extensions": [
      "./src/index.ts"
    ],
    "apiVersion": 5
  }
}
