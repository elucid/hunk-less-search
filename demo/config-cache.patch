diff --git a/src/config/load.ts b/src/config/load.ts
index ebd31e0..8d9f6da 100644
--- a/src/config/load.ts
+++ b/src/config/load.ts
@@ -1,4 +1,4 @@
-import { readFileSync } from "node:fs";
+import { readFileSync, statSync } from "node:fs";
 import { join } from "node:path";
 import { parse } from "smol-toml";
 
@@ -14,15 +14,44 @@ const DEFAULTS: Config = {
   untracked: true,
 };
 
+interface CacheEntry {
+  mtimeMs: number;
+  config: Config;
+}
+
+const cache = new Map<string, CacheEntry>();
+
 export function readConfig(dir: string): Config {
   const path = join(dir, "config.toml");
   const raw = readFileSync(path, "utf8");
   return { ...DEFAULTS, ...(parse(raw) as Partial<Config>) };
 }
 
+/**
+ * Reads the config at most once per edit, so a watch-driven reload does not
+ * re-parse an unchanged file on every changeset rebuild.
+ */
+export function readConfigCached(dir: string): Config {
+  const path = join(dir, "config.toml");
+  const mtimeMs = statSync(path).mtimeMs;
+  const hit = cache.get(path);
+
+  if (hit && hit.mtimeMs === mtimeMs) {
+    return hit.config;
+  }
+
+  const config = readConfig(dir);
+  cache.set(path, { mtimeMs, config });
+  return config;
+}
+
+export function forgetConfig(dir: string) {
+  cache.delete(join(dir, "config.toml"));
+}
+
 export function readConfigOrDefaults(dir: string): Config {
   try {
-    return readConfig(dir);
+    return readConfigCached(dir);
   } catch {
     return DEFAULTS;
   }
