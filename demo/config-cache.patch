 export interface SessionOptions {
   root: string;
@@ -6,12 +6,17 @@ export interface SessionOptions {
 }
 
 export function startSession(options: SessionOptions) {
-  const config = readConfig(options.root);
+  const config = readConfigCached(options.root);
   const server = createServer({ port: options.port, theme: config.theme });
 
   server.on("request", (request) => {
     if (request.path === "/config") {
-      return respond(readConfig(options.root));
+      return respond(readConfigCached(options.root));
+    }
+
+    if (request.path === "/config/reload") {
+      forgetConfig(options.root);
+      return respond(readConfigCached(options.root));
     }
 
     return respond({ ok: true });
diff --git a/tests/config.test.ts b/tests/config.test.ts
index 4550bcf..035a472 100644
