@@ -1,6 +1,14 @@
 import { expect, test } from "bun:test";
-import { readConfig } from "../src/config/load";
+import { forgetConfig, readConfig, readConfigCached } from "../src/config/load";
 
 test("readConfig reads the theme", () => {
   expect(readConfig("fixtures/themed").theme).toBe("ember");
 });
+
+test("readConfigCached reuses the parse until the file changes", () => {
+  const first = readConfigCached("fixtures/themed");
+  expect(readConfigCached("fixtures/themed")).toBe(first);
+
+  forgetConfig("fixtures/themed");
+  expect(readConfigCached("fixtures/themed")).not.toBe(first);
+});
